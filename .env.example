# Adzuna API credentials.
# Free developer account: https://developer.adzuna.com/
# Only required when running with --source=adzuna. The fixture source needs nothing.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Optional: override the Adzuna base URL (useful for a local mock server).
# ADZUNA_BASE_URL=https://api.adzuna.com/v1/api/jobs/es/search
